#!/bin/sh

# PROVIDE: swallowtail_image_engine
# REQUIRE: LOGIN redis
# KEYWORD: shutdown

. /etc/rc.subr

name="swallowtail_image_engine"
rcvar="swallowtail_image_engine_enable"

load_rc_config "$name"

: ${swallowtail_image_engine_enable:="NO"}
: ${swallowtail_image_engine_project_root:="__PROJECT_ROOT__"}
: ${swallowtail_image_engine_python:="/usr/local/bin/python3.11"}
: ${swallowtail_image_engine_php:="/usr/local/bin/php"}
: ${swallowtail_image_engine_worker_user:="swallowtail"}
: ${swallowtail_image_engine_worker_group:="swallowtail"}
: ${swallowtail_image_engine_runner:="/usr/local/libexec/swallowtail_image_engine_worker"}
: ${swallowtail_image_engine_log:="/var/log/swallowtail_image_engine.log"}
: ${swallowtail_image_engine_database_driver:="odbc"}
: ${swallowtail_image_engine_database_dsn:="swallowtail"}
: ${swallowtail_image_engine_database_host:="127.0.0.1"}
: ${swallowtail_image_engine_database_port:="3306"}
: ${swallowtail_image_engine_database_name:="swallowtail"}
: ${swallowtail_image_engine_database_user:="swallowtail_worker"}
: ${swallowtail_image_engine_database_password:=""}
: ${swallowtail_image_engine_redis_host:="127.0.0.1"}
: ${swallowtail_image_engine_redis_port:="6379"}
: ${swallowtail_image_engine_redis_urgent_queue:="swallowtail:conversion:urgent"}
: ${swallowtail_image_engine_redis_normal_queue:="swallowtail:conversion:normal"}
: ${swallowtail_image_engine_redis_timeout_seconds:="5"}
: ${swallowtail_image_engine_rawtherapee_binary:="/usr/local/bin/rawtherapee-cli"}
: ${swallowtail_image_engine_rawtherapee_maximum_threads:="1"}
: ${swallowtail_image_engine_rawtherapee_home:="/var/db/swallowtail-raw-conversion"}
: ${swallowtail_image_engine_rawtherapee_stderr_chars:="4000"}
: ${swallowtail_image_engine_worker_id:="swallowtail-converter-1"}
: ${swallowtail_image_engine_poll_interval_seconds:="5"}
: ${swallowtail_image_engine_job_timeout_seconds:="600"}
: ${swallowtail_image_engine_max_attempts:="3"}
: ${swallowtail_image_engine_retry_delay_seconds:="60"}
: ${swallowtail_image_engine_work_dir:="/var/tmp/swallowtail-raw-conversion"}
: ${swallowtail_image_engine_temp_retention_hours:="24"}
: ${swallowtail_image_engine_log_level:="INFO"}
: ${swallowtail_image_engine_migrate_lock:="/var/run/swallowtail/image_engine_migrate.lock"}

pidfile="/var/run/swallowtail/image_engine.pid"
procname="${swallowtail_image_engine_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_image_engine_worker_user} -o ${swallowtail_image_engine_log} ${swallowtail_image_engine_runner}"
extra_commands="reload onestatus migrate"
start_precmd="swallowtail_image_engine_precmd"
reload_cmd="swallowtail_image_engine_reload"
migrate_cmd="swallowtail_image_engine_migrate"

swallowtail_image_engine_export_env()
{
  export SWALLOWTAIL_IMAGE_ENGINE_PROJECT_ROOT="${swallowtail_image_engine_project_root}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_DRIVER="${swallowtail_image_engine_database_driver}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_DSN="${swallowtail_image_engine_database_dsn}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_HOST="${swallowtail_image_engine_database_host}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_PORT="${swallowtail_image_engine_database_port}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_NAME="${swallowtail_image_engine_database_name}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_USER="${swallowtail_image_engine_database_user}"
  export SWALLOWTAIL_IMAGE_ENGINE_DATABASE_PASSWORD="${swallowtail_image_engine_database_password}"
  export SWALLOWTAIL_IMAGE_ENGINE_REDIS_HOST="${swallowtail_image_engine_redis_host}"
  export SWALLOWTAIL_IMAGE_ENGINE_REDIS_PORT="${swallowtail_image_engine_redis_port}"
  export SWALLOWTAIL_IMAGE_ENGINE_REDIS_URGENT_QUEUE="${swallowtail_image_engine_redis_urgent_queue}"
  export SWALLOWTAIL_IMAGE_ENGINE_REDIS_NORMAL_QUEUE="${swallowtail_image_engine_redis_normal_queue}"
  export SWALLOWTAIL_IMAGE_ENGINE_REDIS_TIMEOUT_SECONDS="${swallowtail_image_engine_redis_timeout_seconds}"
  export SWALLOWTAIL_IMAGE_ENGINE_RAWTHERAPEE_BINARY="${swallowtail_image_engine_rawtherapee_binary}"
  export SWALLOWTAIL_IMAGE_ENGINE_RAWTHERAPEE_MAXIMUM_THREADS="${swallowtail_image_engine_rawtherapee_maximum_threads}"
  export SWALLOWTAIL_IMAGE_ENGINE_RAWTHERAPEE_HOME="${swallowtail_image_engine_rawtherapee_home}"
  export SWALLOWTAIL_IMAGE_ENGINE_RAWTHERAPEE_STDERR_CHARS="${swallowtail_image_engine_rawtherapee_stderr_chars}"
  export SWALLOWTAIL_IMAGE_ENGINE_WORKER_ID="${swallowtail_image_engine_worker_id}"
  export SWALLOWTAIL_IMAGE_ENGINE_POLL_INTERVAL_SECONDS="${swallowtail_image_engine_poll_interval_seconds}"
  export SWALLOWTAIL_IMAGE_ENGINE_JOB_TIMEOUT_SECONDS="${swallowtail_image_engine_job_timeout_seconds}"
  export SWALLOWTAIL_IMAGE_ENGINE_MAX_ATTEMPTS="${swallowtail_image_engine_max_attempts}"
  export SWALLOWTAIL_IMAGE_ENGINE_RETRY_DELAY_SECONDS="${swallowtail_image_engine_retry_delay_seconds}"
  export SWALLOWTAIL_IMAGE_ENGINE_WORK_DIR="${swallowtail_image_engine_work_dir}"
  export SWALLOWTAIL_IMAGE_ENGINE_TEMP_RETENTION_HOURS="${swallowtail_image_engine_temp_retention_hours}"
  export SWALLOWTAIL_IMAGE_ENGINE_LOG_FILE="${swallowtail_image_engine_log}"
  export SWALLOWTAIL_IMAGE_ENGINE_LOG_LEVEL="${swallowtail_image_engine_log_level}"
}

swallowtail_image_engine_precmd()
{
  install -d -o "${swallowtail_image_engine_worker_user}" \
    -g "${swallowtail_image_engine_worker_group}" -m 0750 \
    "${swallowtail_image_engine_rawtherapee_home}" \
    "${swallowtail_image_engine_work_dir}" \
    /var/run/swallowtail

  if [ ! -f "${swallowtail_image_engine_log}" ]; then
    install -o "${swallowtail_image_engine_worker_user}" \
      -g "${swallowtail_image_engine_worker_group}" -m 0640 \
      /dev/null "${swallowtail_image_engine_log}"
  fi

  export PYTHONPATH="${swallowtail_image_engine_project_root}/service/image_engine"
  export PYTHONDONTWRITEBYTECODE=1
  swallowtail_image_engine_export_env
  ${swallowtail_image_engine_python} -m raw_conversion --health
}

swallowtail_image_engine_reload()
{
  swallowtail_image_engine_precmd
  echo "Configuration is valid. Restart ${name} to apply changes."
}

swallowtail_image_engine_migrate()
{
  lockf -k "${swallowtail_image_engine_migrate_lock}" /bin/sh -c '
    set -u

    pidfile="$1"
    project_root="$2"
    php="$3"
    service_script="$4"

    was_running=0
    if [ -f "${pidfile}" ]; then
      pid=$(cat "${pidfile}" 2>/dev/null || true)
      if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        was_running=1
      fi
    fi

    if [ "${was_running}" -eq 1 ]; then
      "${service_script}" stop || exit $?
    fi

    cd "${project_root}" || exit $?
    "${php}" tools/php/setupDb.php --migrate-only
    migrate_status=$?

    start_status=0
    if [ "${was_running}" -eq 1 ]; then
      "${service_script}" start || start_status=$?
    fi

    if [ "${migrate_status}" -ne 0 ]; then
      exit "${migrate_status}"
    fi
    exit "${start_status}"
  ' migrate "${pidfile}" "${swallowtail_image_engine_project_root}" "${swallowtail_image_engine_php}" "$0"
}

run_rc_command "$1"
