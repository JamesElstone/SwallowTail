#!/bin/sh

# PROVIDE: swallowtail_raw_conversion
# REQUIRE: LOGIN redis
# KEYWORD: shutdown

. /etc/rc.subr

name="swallowtail_raw_conversion"
rcvar="swallowtail_raw_conversion_enable"

load_rc_config "$name"

: ${swallowtail_raw_conversion_enable:="NO"}
: ${swallowtail_raw_conversion_project_root:="__PROJECT_ROOT__"}
: ${swallowtail_raw_conversion_config:="/usr/local/etc/swallowtail/raw-conversion.ini"}
: ${swallowtail_raw_conversion_python:="/usr/local/bin/python3.11"}
: ${swallowtail_raw_conversion_php:="/usr/local/bin/php"}
: ${swallowtail_raw_conversion_worker_user:="swallowtail"}
: ${swallowtail_raw_conversion_runner:="/usr/local/libexec/swallowtail_raw_conversion_worker"}
: ${swallowtail_raw_conversion_log:="/var/log/swallowtail_raw_conversion.log"}
: ${swallowtail_raw_conversion_migrate_lock:="/var/run/swallowtail/raw_conversion_migrate.lock"}

pidfile="/var/run/swallowtail/raw_conversion.pid"
procname="${swallowtail_raw_conversion_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_raw_conversion_worker_user} -o ${swallowtail_raw_conversion_log} ${swallowtail_raw_conversion_runner}"
required_files="${swallowtail_raw_conversion_config}"
extra_commands="reload onestatus migrate"
start_precmd="swallowtail_raw_conversion_precmd"
reload_cmd="swallowtail_raw_conversion_reload"
migrate_cmd="swallowtail_raw_conversion_migrate"

swallowtail_raw_conversion_precmd()
{
  export PYTHONPATH="${swallowtail_raw_conversion_project_root}/service/rawConversion"
  export PYTHONDONTWRITEBYTECODE=1
  ${swallowtail_raw_conversion_python} -m raw_conversion --config "${swallowtail_raw_conversion_config}" --health
}

swallowtail_raw_conversion_reload()
{
  swallowtail_raw_conversion_precmd
  echo "Configuration is valid. Restart ${name} to apply changes."
}

swallowtail_raw_conversion_migrate()
{
  lockf -k "${swallowtail_raw_conversion_migrate_lock}" /bin/sh -c '
    set -u

    pidfile="$1"
    project_root="$2"
    php="$3"
    service_script="$4"

    was_running=0
    if [ -f "${pidfile}" ]; then
      pid=$(cat "${pidfile}" 2>/dev/null || true)
      if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
        was_running=1
      fi
    fi

    if [ "${was_running}" -eq 1 ]; then
      "${service_script}" stop || exit $?
    fi

    cd "${project_root}" || exit $?
    "${php}" tools/php/setupDb.php --migrate-only
    migrate_status=$?

    start_status=0
    if [ "${was_running}" -eq 1 ]; then
      "${service_script}" start || start_status=$?
    fi

    if [ "${migrate_status}" -ne 0 ]; then
      exit "${migrate_status}"
    fi
    exit "${start_status}"
  ' migrate "${pidfile}" "${swallowtail_raw_conversion_project_root}" "${swallowtail_raw_conversion_php}" "$0"
}

run_rc_command "$1"
