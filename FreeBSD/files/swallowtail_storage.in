#!/bin/sh

# PROVIDE: swallowtail_storage
# REQUIRE: LOGIN redis
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf to enable this service:
#
# swallowtail_storage_enable="YES"
#
# Service defaults can be overridden with swallowtail_storage_* variables.

. /etc/rc.subr

name="swallowtail_storage"
rcvar="swallowtail_storage_enable"

load_rc_config "$name"

: ${swallowtail_storage_enable:="NO"}
: ${swallowtail_storage_project_root:="%%SWALLOWTAIL_ROOT%%"}
: ${swallowtail_storage_python:="%%PYTHON_CMD%%"}
: ${swallowtail_storage_php:="%%PHP_CMD%%"}
: ${swallowtail_storage_worker_user:="swallowtail"}
: ${swallowtail_storage_worker_group:="swallowtail"}
: ${swallowtail_storage_interval_seconds:="300"}
: ${swallowtail_storage_mount_poll_seconds:="30"}
: ${swallowtail_storage_migration_item_limit:="10"}
: ${swallowtail_storage_redis_host:="127.0.0.1"}
: ${swallowtail_storage_redis_port:="6379"}
: ${swallowtail_storage_redis_timeout_seconds:="5"}
: ${swallowtail_storage_redis_snapshot_key:="swallowtail:storage:snapshot"}
: ${swallowtail_storage_redis_snapshot_ttl_seconds:="360"}
: ${swallowtail_storage_redis_storage_wake_queue:="swallowtail:conversion:storage_wake"}
: ${swallowtail_storage_log:="%%SWALLOWTAIL_LOG_DIR%%/swallowtail_storage.log"}
: ${swallowtail_storage_log_level:="INFO"}
pidfile="/var/run/swallowtail/storage.pid"
procname="${swallowtail_storage_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_storage_worker_user} -o ${swallowtail_storage_log} ${swallowtail_storage_python} -m swallowtail_storage"
required_files="${swallowtail_storage_python} ${swallowtail_storage_php}"
required_dirs="${swallowtail_storage_project_root}/services/swallowtail_storage/src"
extra_commands="onestatus"
start_precmd="swallowtail_storage_precmd"
start_postcmd="swallowtail_storage_postcmd"
status_cmd="swallowtail_storage_status"

swallowtail_storage_export_env()
{
	export SWALLOWTAIL_STORAGE_PROJECT_ROOT="${swallowtail_storage_project_root}"
	export SWALLOWTAIL_STORAGE_PHP="${swallowtail_storage_php}"
	export SWALLOWTAIL_STORAGE_INTERVAL_SECONDS="${swallowtail_storage_interval_seconds}"
	export SWALLOWTAIL_STORAGE_MOUNT_POLL_SECONDS="${swallowtail_storage_mount_poll_seconds}"
	export SWALLOWTAIL_STORAGE_MIGRATION_ITEM_LIMIT="${swallowtail_storage_migration_item_limit}"
	export SWALLOWTAIL_STORAGE_REDIS_HOST="${swallowtail_storage_redis_host}"
	export SWALLOWTAIL_STORAGE_REDIS_PORT="${swallowtail_storage_redis_port}"
	export SWALLOWTAIL_STORAGE_REDIS_TIMEOUT_SECONDS="${swallowtail_storage_redis_timeout_seconds}"
	export SWALLOWTAIL_STORAGE_REDIS_SNAPSHOT_KEY="${swallowtail_storage_redis_snapshot_key}"
	export SWALLOWTAIL_STORAGE_REDIS_SNAPSHOT_TTL_SECONDS="${swallowtail_storage_redis_snapshot_ttl_seconds}"
	export SWALLOWTAIL_STORAGE_REDIS_STORAGE_WAKE_QUEUE="${swallowtail_storage_redis_storage_wake_queue}"
	export SWALLOWTAIL_STORAGE_LOG_FILE="${swallowtail_storage_log}"
	export SWALLOWTAIL_STORAGE_LOG_LEVEL="${swallowtail_storage_log_level}"
	export PYTHONPATH="${swallowtail_storage_project_root}/services/swallowtail_storage/src"
	export PYTHONDONTWRITEBYTECODE=1
}

swallowtail_storage_require_root()
{
	requested_command=$1
	base_command=${requested_command}

	case "${base_command}" in
	one*) base_command=${base_command#one} ;;
	force*) base_command=${base_command#force} ;;
	fast*) base_command=${base_command#fast} ;;
	esac

	case "${base_command}" in
	start|stop|restart)
		if [ "$(id -u)" -ne 0 ]; then
			echo "${name}: please run '${requested_command}' as root, for example: service ${name} ${requested_command}" >&2
			exit 1
		fi
		;;
	esac
}

swallowtail_storage_precmd()
{
	install -d -o "${swallowtail_storage_worker_user}" \
		-g "${swallowtail_storage_worker_group}" -m 0750 \
		/var/run/swallowtail
	install -d -o "${swallowtail_storage_worker_user}" \
		-g "${swallowtail_storage_worker_group}" -m 2775 \
		"$(dirname "${swallowtail_storage_log}")"

	if [ ! -f "${swallowtail_storage_log}" ]; then
		install -o "${swallowtail_storage_worker_user}" \
			-g "${swallowtail_storage_worker_group}" -m 0640 \
			/dev/null "${swallowtail_storage_log}"
	fi

	swallowtail_storage_export_env
	${swallowtail_storage_python} -m swallowtail_storage --health
}

swallowtail_storage_postcmd()
{
	if [ -f "${pidfile}" ]; then
		chmod 0640 "${pidfile}" 2>/dev/null || true
	fi
}

swallowtail_storage_process_status()
{
	if [ -f "${pidfile}" ]; then
		pid=$(cat "${pidfile}" 2>/dev/null || true)
		if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
			echo "${name} is running as pid ${pid}"
			return 0
		fi
	fi

	echo "${name} is not running"
	return 1
}

swallowtail_storage_health_status()
{
	swallowtail_storage_export_env
	${swallowtail_storage_python} -m swallowtail_storage --health
}

swallowtail_storage_status()
{
	status=0

	swallowtail_storage_process_status || status=$?
	swallowtail_storage_health_status || status=$?

	return "${status}"
}

swallowtail_storage_require_root "$1"
run_rc_command "$1"
