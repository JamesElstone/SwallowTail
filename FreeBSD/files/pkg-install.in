#!/bin/sh

case "$2" in
PRE-INSTALL)
	if ! pw groupshow swallowtail >/dev/null 2>&1; then
		pw groupadd swallowtail
	fi

	if ! pw usershow swallowtail >/dev/null 2>&1; then
		pw useradd swallowtail \
			-g swallowtail \
			-c "SwallowTail service account" \
			-d /nonexistent \
			-s /usr/sbin/nologin
	fi

	if pw usershow www >/dev/null 2>&1 \
		&& ! id -nG www | tr ' ' '\n' | grep -Fx swallowtail >/dev/null 2>&1; then
		pw groupmod swallowtail -m www
	fi
	;;
esac
