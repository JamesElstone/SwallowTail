LoadModule proxy_module libexec/apache24/mod_proxy.so
LoadModule proxy_fcgi_module libexec/apache24/mod_proxy_fcgi.so
LoadModule rewrite_module libexec/apache24/mod_rewrite.so

ServerName %%SWALLOWTAIL_SERVER_NAME%%:%%SWALLOWTAIL_HTTP_PORT%%

<VirtualHost *:%%SWALLOWTAIL_HTTP_PORT%%>
    ServerName %%SWALLOWTAIL_SERVER_NAME%%
    DocumentRoot "%%SWALLOWTAIL_ROOT%%/web_root"

    DirectoryIndex index.php index.html

    <Directory "%%SWALLOWTAIL_ROOT%%/web_root">
        Options -Indexes +FollowSymLinks
        AllowOverride All
        Require all granted
    </Directory>

    <FilesMatch "\.php$">
        SetHandler "proxy:fcgi://%%SWALLOWTAIL_PHP_FPM_LISTEN%%"
    </FilesMatch>

    ErrorLog "%%SWALLOWTAIL_LOG_DIR%%/httpd-swallowtail-error.log"
    LogFormat "%h %l %u %t \"%r\" %>s %b \"%{Referer}i\" \"%{User-agent}i\" duration_us=%D forwarded_for=\"%{X-Forwarded-For}i\" forwarded_proto=\"%{X-Forwarded-Proto}i\"" swallowtail_combined_timed
    CustomLog "%%SWALLOWTAIL_LOG_DIR%%/httpd-swallowtail-access.log" swallowtail_combined_timed
</VirtualHost>
