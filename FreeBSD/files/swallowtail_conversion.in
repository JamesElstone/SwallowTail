#!/bin/sh

# PROVIDE: swallowtail_conversion
# REQUIRE: LOGIN redis
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf to enable this service:
#
# swallowtail_conversion_enable="YES"
#
# Service defaults can be overridden with swallowtail_conversion_* variables.
# Database settings are read from ${swallowtail_conversion_project_root}/secure/app.php.

. /etc/rc.subr

name="swallowtail_conversion"
rcvar="swallowtail_conversion_enable"

load_rc_config "$name"

: ${swallowtail_conversion_enable:="NO"}
: ${swallowtail_conversion_project_root:="%%SWALLOWTAIL_ROOT%%"}
: ${swallowtail_conversion_python:="%%PYTHON_CMD%%"}
: ${swallowtail_conversion_php:="%%PHP_CMD%%"}
: ${swallowtail_conversion_app_config:="${swallowtail_conversion_project_root}/secure/app.php"}
: ${swallowtail_conversion_worker_user:="swallowtail"}
: ${swallowtail_conversion_worker_group:="swallowtail"}
: ${swallowtail_conversion_log:="%%SWALLOWTAIL_LOG_DIR%%/swallowtail_conversion.log"}
: ${swallowtail_conversion_redis_host:="127.0.0.1"}
: ${swallowtail_conversion_redis_port:="6379"}
: ${swallowtail_conversion_redis_urgent_queue:="swallowtail:conversion:urgent"}
: ${swallowtail_conversion_redis_normal_queue:="swallowtail:conversion:normal"}
: ${swallowtail_conversion_redis_timeout_seconds:="5"}
: ${swallowtail_conversion_rawtherapee_binary:="%%PREFIX%%/bin/rawtherapee-cli"}
: ${swallowtail_conversion_rawtherapee_maximum_threads:="1"}
: ${swallowtail_conversion_rawtherapee_home:="/var/db/swallowtail_conversion"}
: ${swallowtail_conversion_rawtherapee_stderr_chars:="4000"}
: ${swallowtail_conversion_worker_id:="swallowtail-converter-1"}
: ${swallowtail_conversion_poll_interval_seconds:="5"}
: ${swallowtail_conversion_job_timeout_seconds:="600"}
: ${swallowtail_conversion_max_attempts:="3"}
: ${swallowtail_conversion_retry_delay_seconds:="60"}
: ${swallowtail_conversion_work_dir:="/var/tmp/swallowtail_conversion"}
: ${swallowtail_conversion_temp_retention_hours:="24"}
: ${swallowtail_conversion_log_level:="INFO"}
: ${swallowtail_conversion_migrate_lock:="/var/run/swallowtail/swallowtail_conversion_migrate.lock"}

pidfile="/var/run/swallowtail/swallowtail_conversion.pid"
procname="${swallowtail_conversion_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_conversion_worker_user} -o ${swallowtail_conversion_log} ${swallowtail_conversion_python} -m swallowtail_conversion"
required_files="${swallowtail_conversion_python} ${swallowtail_conversion_php} ${swallowtail_conversion_app_config}"
required_dirs="${swallowtail_conversion_project_root}/services/swallowtail_conversion/src"
extra_commands="reload onestatus migrate"
start_precmd="swallowtail_conversion_precmd"
start_postcmd="swallowtail_conversion_postcmd"
status_cmd="swallowtail_conversion_status"
reload_cmd="swallowtail_conversion_reload"
migrate_cmd="swallowtail_conversion_migrate"

swallowtail_conversion_export_env()
{
	export SWALLOWTAIL_CONVERSION_PROJECT_ROOT="${swallowtail_conversion_project_root}"
	export SWALLOWTAIL_CONVERSION_APP_CONFIG="${swallowtail_conversion_app_config}"
	export SWALLOWTAIL_CONVERSION_PHP_BINARY="${swallowtail_conversion_php}"
	export SWALLOWTAIL_CONVERSION_REDIS_HOST="${swallowtail_conversion_redis_host}"
	export SWALLOWTAIL_CONVERSION_REDIS_PORT="${swallowtail_conversion_redis_port}"
	export SWALLOWTAIL_CONVERSION_REDIS_URGENT_QUEUE="${swallowtail_conversion_redis_urgent_queue}"
	export SWALLOWTAIL_CONVERSION_REDIS_NORMAL_QUEUE="${swallowtail_conversion_redis_normal_queue}"
	export SWALLOWTAIL_CONVERSION_REDIS_TIMEOUT_SECONDS="${swallowtail_conversion_redis_timeout_seconds}"
	export SWALLOWTAIL_CONVERSION_RAWTHERAPEE_BINARY="${swallowtail_conversion_rawtherapee_binary}"
	export SWALLOWTAIL_CONVERSION_RAWTHERAPEE_MAXIMUM_THREADS="${swallowtail_conversion_rawtherapee_maximum_threads}"
	export SWALLOWTAIL_CONVERSION_RAWTHERAPEE_HOME="${swallowtail_conversion_rawtherapee_home}"
	export SWALLOWTAIL_CONVERSION_RAWTHERAPEE_STDERR_CHARS="${swallowtail_conversion_rawtherapee_stderr_chars}"
	export SWALLOWTAIL_CONVERSION_WORKER_ID="${swallowtail_conversion_worker_id}"
	export SWALLOWTAIL_CONVERSION_POLL_INTERVAL_SECONDS="${swallowtail_conversion_poll_interval_seconds}"
	export SWALLOWTAIL_CONVERSION_JOB_TIMEOUT_SECONDS="${swallowtail_conversion_job_timeout_seconds}"
	export SWALLOWTAIL_CONVERSION_MAX_ATTEMPTS="${swallowtail_conversion_max_attempts}"
	export SWALLOWTAIL_CONVERSION_RETRY_DELAY_SECONDS="${swallowtail_conversion_retry_delay_seconds}"
	export SWALLOWTAIL_CONVERSION_WORK_DIR="${swallowtail_conversion_work_dir}"
	export SWALLOWTAIL_CONVERSION_TEMP_RETENTION_HOURS="${swallowtail_conversion_temp_retention_hours}"
	export SWALLOWTAIL_CONVERSION_LOG_FILE="${swallowtail_conversion_log}"
	export SWALLOWTAIL_CONVERSION_LOG_LEVEL="${swallowtail_conversion_log_level}"
	export PYTHONPATH="${swallowtail_conversion_project_root}/services/swallowtail_conversion/src"
	export PYTHONDONTWRITEBYTECODE=1
}

swallowtail_conversion_require_root()
{
	requested_command=$1
	base_command=${requested_command}

	case "${base_command}" in
	one*) base_command=${base_command#one} ;;
	force*) base_command=${base_command#force} ;;
	fast*) base_command=${base_command#fast} ;;
	esac

	case "${base_command}" in
	start|stop|restart|reload|migrate)
		if [ "$(id -u)" -ne 0 ]; then
			echo "${name}: please run '${requested_command}' as root, for example: service ${name} ${requested_command}" >&2
			exit 1
		fi
		;;
	esac
}

swallowtail_conversion_precmd()
{
	install -d -o "${swallowtail_conversion_worker_user}" \
		-g "${swallowtail_conversion_worker_group}" -m 0750 \
		"${swallowtail_conversion_rawtherapee_home}" \
		"${swallowtail_conversion_work_dir}" \
		/var/run/swallowtail
	install -d -o "${swallowtail_conversion_worker_user}" \
		-g "${swallowtail_conversion_worker_group}" -m 2775 \
		"$(dirname "${swallowtail_conversion_log}")"

	if [ ! -f "${swallowtail_conversion_log}" ]; then
		install -o "${swallowtail_conversion_worker_user}" \
			-g "${swallowtail_conversion_worker_group}" -m 0640 \
			/dev/null "${swallowtail_conversion_log}"
	fi

	swallowtail_conversion_export_env
	${swallowtail_conversion_python} -m swallowtail_conversion --health
}

swallowtail_conversion_postcmd()
{
	if [ -f "${pidfile}" ]; then
		chmod 0640 "${pidfile}" 2>/dev/null || true
	fi
}

swallowtail_conversion_reload()
{
	swallowtail_conversion_precmd
	echo "Configuration is valid. Restart ${name} to apply changes."
}

swallowtail_conversion_process_status()
{
	if [ -f "${pidfile}" ]; then
		pid=$(cat "${pidfile}" 2>/dev/null || true)
		if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
			echo "${name} is running as pid ${pid}"
			return 0
		fi
	fi

	echo "${name} is not running"
	return 1
}

swallowtail_conversion_health_status()
{
	swallowtail_conversion_export_env
	${swallowtail_conversion_python} -m swallowtail_conversion --health
}

swallowtail_conversion_status()
{
	status=0

	swallowtail_conversion_process_status || status=$?
	swallowtail_conversion_health_status || status=$?

	return "${status}"
}

swallowtail_conversion_migrate()
{
	lockf -k "${swallowtail_conversion_migrate_lock}" /bin/sh -c '
		set -u

		pidfile="$1"
		project_root="$2"
		php="$3"
		service_script="$4"

		was_running=0
		if [ -f "${pidfile}" ]; then
			pid=$(cat "${pidfile}" 2>/dev/null || true)
			if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
				was_running=1
			fi
		fi

		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" stop || exit $?
		fi

		cd "${project_root}" || exit $?
		"${php}" tools/php/setupDb.php --migrate-only
		migrate_status=$?

		start_status=0
		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" start || start_status=$?
		fi

		if [ "${migrate_status}" -ne 0 ]; then
			exit "${migrate_status}"
		fi
		exit "${start_status}"
	' migrate "${pidfile}" "${swallowtail_conversion_project_root}" "${swallowtail_conversion_php}" "$0"
}

swallowtail_conversion_require_root "$1"
run_rc_command "$1"
