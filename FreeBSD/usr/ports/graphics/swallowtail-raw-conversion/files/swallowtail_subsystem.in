#!/bin/sh

# PROVIDE: swallowtail_subsystem
# REQUIRE: LOGIN redis
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf to enable this service:
#
# swallowtail_subsystem_enable="YES"
#
# Service defaults can be overridden with swallowtail_subsystem_* variables.

. /etc/rc.subr

name="swallowtail_subsystem"
rcvar="swallowtail_subsystem_enable"

load_rc_config "$name"

: ${swallowtail_subsystem_enable:="NO"}
: ${swallowtail_subsystem_project_root:="%%SWALLOWTAIL_ROOT%%"}
: ${swallowtail_subsystem_python:="%%PYTHON_CMD%%"}
: ${swallowtail_subsystem_php:="%%PHP_CMD%%"}
: ${swallowtail_subsystem_worker_user:="swallowtail"}
: ${swallowtail_subsystem_worker_group:="swallowtail"}
: ${swallowtail_subsystem_runner:="%%PREFIX%%/libexec/swallowtail_subsystem_worker"}
: ${swallowtail_subsystem_log:="/var/log/swallowtail_subsystem.log"}
: ${swallowtail_subsystem_database_driver:="odbc"}
: ${swallowtail_subsystem_database_dsn:="swallowtail"}
: ${swallowtail_subsystem_database_host:="127.0.0.1"}
: ${swallowtail_subsystem_database_port:="3306"}
: ${swallowtail_subsystem_database_name:="swallowtail"}
: ${swallowtail_subsystem_database_user:="swallowtail_worker"}
: ${swallowtail_subsystem_database_password:=""}
: ${swallowtail_subsystem_redis_host:="127.0.0.1"}
: ${swallowtail_subsystem_redis_port:="6379"}
: ${swallowtail_subsystem_redis_urgent_queue:="swallowtail:conversion:urgent"}
: ${swallowtail_subsystem_redis_normal_queue:="swallowtail:conversion:normal"}
: ${swallowtail_subsystem_redis_timeout_seconds:="5"}
: ${swallowtail_subsystem_rawtherapee_binary:="%%PREFIX%%/bin/rawtherapee-cli"}
: ${swallowtail_subsystem_rawtherapee_maximum_threads:="1"}
: ${swallowtail_subsystem_rawtherapee_home:="/var/db/swallowtail-raw-conversion"}
: ${swallowtail_subsystem_rawtherapee_stderr_chars:="4000"}
: ${swallowtail_subsystem_worker_id:="swallowtail-converter-1"}
: ${swallowtail_subsystem_poll_interval_seconds:="5"}
: ${swallowtail_subsystem_job_timeout_seconds:="600"}
: ${swallowtail_subsystem_max_attempts:="3"}
: ${swallowtail_subsystem_retry_delay_seconds:="60"}
: ${swallowtail_subsystem_work_dir:="/var/tmp/swallowtail-raw-conversion"}
: ${swallowtail_subsystem_temp_retention_hours:="24"}
: ${swallowtail_subsystem_log_level:="INFO"}
: ${swallowtail_subsystem_migrate_lock:="/var/run/swallowtail/subsystem_migrate.lock"}

pidfile="/var/run/swallowtail/subsystem.pid"
procname="${swallowtail_subsystem_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_subsystem_worker_user} -o ${swallowtail_subsystem_log} ${swallowtail_subsystem_runner}"
required_dirs="${swallowtail_subsystem_project_root}/service/subsystem"
extra_commands="reload onestatus migrate"
start_precmd="swallowtail_subsystem_precmd"
reload_cmd="swallowtail_subsystem_reload"
migrate_cmd="swallowtail_subsystem_migrate"

swallowtail_subsystem_export_env()
{
	export SWALLOWTAIL_SUBSYSTEM_PROJECT_ROOT="${swallowtail_subsystem_project_root}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_DRIVER="${swallowtail_subsystem_database_driver}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_DSN="${swallowtail_subsystem_database_dsn}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_HOST="${swallowtail_subsystem_database_host}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_PORT="${swallowtail_subsystem_database_port}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_NAME="${swallowtail_subsystem_database_name}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_USER="${swallowtail_subsystem_database_user}"
	export SWALLOWTAIL_SUBSYSTEM_DATABASE_PASSWORD="${swallowtail_subsystem_database_password}"
	export SWALLOWTAIL_SUBSYSTEM_REDIS_HOST="${swallowtail_subsystem_redis_host}"
	export SWALLOWTAIL_SUBSYSTEM_REDIS_PORT="${swallowtail_subsystem_redis_port}"
	export SWALLOWTAIL_SUBSYSTEM_REDIS_URGENT_QUEUE="${swallowtail_subsystem_redis_urgent_queue}"
	export SWALLOWTAIL_SUBSYSTEM_REDIS_NORMAL_QUEUE="${swallowtail_subsystem_redis_normal_queue}"
	export SWALLOWTAIL_SUBSYSTEM_REDIS_TIMEOUT_SECONDS="${swallowtail_subsystem_redis_timeout_seconds}"
	export SWALLOWTAIL_SUBSYSTEM_RAWTHERAPEE_BINARY="${swallowtail_subsystem_rawtherapee_binary}"
	export SWALLOWTAIL_SUBSYSTEM_RAWTHERAPEE_MAXIMUM_THREADS="${swallowtail_subsystem_rawtherapee_maximum_threads}"
	export SWALLOWTAIL_SUBSYSTEM_RAWTHERAPEE_HOME="${swallowtail_subsystem_rawtherapee_home}"
	export SWALLOWTAIL_SUBSYSTEM_RAWTHERAPEE_STDERR_CHARS="${swallowtail_subsystem_rawtherapee_stderr_chars}"
	export SWALLOWTAIL_SUBSYSTEM_WORKER_ID="${swallowtail_subsystem_worker_id}"
	export SWALLOWTAIL_SUBSYSTEM_POLL_INTERVAL_SECONDS="${swallowtail_subsystem_poll_interval_seconds}"
	export SWALLOWTAIL_SUBSYSTEM_JOB_TIMEOUT_SECONDS="${swallowtail_subsystem_job_timeout_seconds}"
	export SWALLOWTAIL_SUBSYSTEM_MAX_ATTEMPTS="${swallowtail_subsystem_max_attempts}"
	export SWALLOWTAIL_SUBSYSTEM_RETRY_DELAY_SECONDS="${swallowtail_subsystem_retry_delay_seconds}"
	export SWALLOWTAIL_SUBSYSTEM_WORK_DIR="${swallowtail_subsystem_work_dir}"
	export SWALLOWTAIL_SUBSYSTEM_TEMP_RETENTION_HOURS="${swallowtail_subsystem_temp_retention_hours}"
	export SWALLOWTAIL_SUBSYSTEM_LOG_FILE="${swallowtail_subsystem_log}"
	export SWALLOWTAIL_SUBSYSTEM_LOG_LEVEL="${swallowtail_subsystem_log_level}"
}

swallowtail_subsystem_precmd()
{
	install -d -o "${swallowtail_subsystem_worker_user}" \
		-g "${swallowtail_subsystem_worker_group}" -m 0750 \
		"${swallowtail_subsystem_rawtherapee_home}" \
		"${swallowtail_subsystem_work_dir}" \
		/var/run/swallowtail

	if [ ! -f "${swallowtail_subsystem_log}" ]; then
		install -o "${swallowtail_subsystem_worker_user}" \
			-g "${swallowtail_subsystem_worker_group}" -m 0640 \
			/dev/null "${swallowtail_subsystem_log}"
	fi

	swallowtail_subsystem_export_env
	${swallowtail_subsystem_runner} --health
}

swallowtail_subsystem_reload()
{
	swallowtail_subsystem_precmd
	echo "Configuration is valid. Restart ${name} to apply changes."
}

swallowtail_subsystem_migrate()
{
	lockf -k "${swallowtail_subsystem_migrate_lock}" /bin/sh -c '
		set -u

		pidfile="$1"
		project_root="$2"
		php="$3"
		service_script="$4"

		was_running=0
		if [ -f "${pidfile}" ]; then
			pid=$(cat "${pidfile}" 2>/dev/null || true)
			if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
				was_running=1
			fi
		fi

		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" stop || exit $?
		fi

		cd "${project_root}" || exit $?
		"${php}" tools/php/setupDb.php --migrate-only
		migrate_status=$?

		start_status=0
		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" start || start_status=$?
		fi

		if [ "${migrate_status}" -ne 0 ]; then
			exit "${migrate_status}"
		fi
		exit "${start_status}"
	' migrate "${pidfile}" "${swallowtail_subsystem_project_root}" "${swallowtail_subsystem_php}" "$0"
}

run_rc_command "$1"
