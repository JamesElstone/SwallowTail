#!/bin/sh

# PROVIDE: swallowtail_subsystem
# REQUIRE: LOGIN redis
# KEYWORD: shutdown
#
# Add these lines to /etc/rc.conf.local or /etc/rc.conf
# to enable this service:
#
# swallowtail_subsystem_enable (bool): Set to NO by default.
# swallowtail_subsystem_project_root (path): Set to %%SWALLOWTAIL_ROOT%% by default.
# swallowtail_subsystem_config (path): Set to %%PREFIX%%/etc/swallowtail/raw-conversion.ini by default.

. /etc/rc.subr

name="swallowtail_subsystem"
rcvar="swallowtail_subsystem_enable"

load_rc_config "$name"

: ${swallowtail_subsystem_enable:="NO"}
: ${swallowtail_subsystem_project_root:="%%SWALLOWTAIL_ROOT%%"}
: ${swallowtail_subsystem_config:="%%PREFIX%%/etc/swallowtail/raw-conversion.ini"}
: ${swallowtail_subsystem_python:="%%PYTHON_CMD%%"}
: ${swallowtail_subsystem_php:="%%PHP_CMD%%"}
: ${swallowtail_subsystem_worker_user:="swallowtail"}
: ${swallowtail_subsystem_worker_group:="swallowtail"}
: ${swallowtail_subsystem_runner:="%%PREFIX%%/libexec/swallowtail_subsystem_worker"}
: ${swallowtail_subsystem_log:="/var/log/swallowtail_subsystem.log"}
: ${swallowtail_subsystem_migrate_lock:="/var/run/swallowtail/subsystem_migrate.lock"}

pidfile="/var/run/swallowtail/subsystem.pid"
procname="${swallowtail_subsystem_python}"
command="/usr/sbin/daemon"
command_args="-f -p ${pidfile} -u ${swallowtail_subsystem_worker_user} -o ${swallowtail_subsystem_log} ${swallowtail_subsystem_runner}"
required_dirs="${swallowtail_subsystem_project_root}/service/subsystem"
required_files="${swallowtail_subsystem_config}"
extra_commands="reload onestatus migrate"
start_precmd="swallowtail_subsystem_precmd"
reload_cmd="swallowtail_subsystem_reload"
migrate_cmd="swallowtail_subsystem_migrate"

swallowtail_subsystem_precmd()
{
	install -d -o "${swallowtail_subsystem_worker_user}" \
		-g "${swallowtail_subsystem_worker_group}" -m 0750 \
		/var/db/swallowtail-raw-conversion \
		/var/tmp/swallowtail-raw-conversion \
		/var/run/swallowtail

	if [ ! -f "${swallowtail_subsystem_log}" ]; then
		install -o "${swallowtail_subsystem_worker_user}" \
			-g "${swallowtail_subsystem_worker_group}" -m 0640 \
			/dev/null "${swallowtail_subsystem_log}"
	fi

	export PYTHONPATH="${swallowtail_subsystem_project_root}/service/subsystem"
	export PYTHONDONTWRITEBYTECODE=1
	export swallowtail_subsystem_config
	export swallowtail_subsystem_project_root
	${swallowtail_subsystem_python} -m raw_conversion --config "${swallowtail_subsystem_config}" --health
}

swallowtail_subsystem_reload()
{
	swallowtail_subsystem_precmd
	echo "Configuration is valid. Restart ${name} to apply changes."
}

swallowtail_subsystem_migrate()
{
	lockf -k "${swallowtail_subsystem_migrate_lock}" /bin/sh -c '
		set -u

		pidfile="$1"
		project_root="$2"
		php="$3"
		service_script="$4"

		was_running=0
		if [ -f "${pidfile}" ]; then
			pid=$(cat "${pidfile}" 2>/dev/null || true)
			if [ -n "${pid}" ] && kill -0 "${pid}" 2>/dev/null; then
				was_running=1
			fi
		fi

		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" stop || exit $?
		fi

		cd "${project_root}" || exit $?
		"${php}" tools/php/setupDb.php --migrate-only
		migrate_status=$?

		start_status=0
		if [ "${was_running}" -eq 1 ]; then
			"${service_script}" start || start_status=$?
		fi

		if [ "${migrate_status}" -ne 0 ]; then
			exit "${migrate_status}"
		fi
		exit "${start_status}"
	' migrate "${pidfile}" "${swallowtail_subsystem_project_root}" "${swallowtail_subsystem_php}" "$0"
}

run_rc_command "$1"
